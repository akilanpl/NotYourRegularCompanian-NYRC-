{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NYRC",
  "version": "1.0.0-rc.1",
  "identifier": "com.nyrc.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "NYRC",
        "width": 360,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false,
        "shadow": false,
        "center": false,
        "x": 100,
        "y": 100
      },
      {
        "label": "settings",
        "title": "NYRC \u2014 Settings",
        "url": "index.html#/settings",
        "width": 520,
        "height": 640,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "NYRC \u2014 local-first intelligent personal companion",
    "longDescription": "NYRC is a local-first intelligent personal companion designed to remain useful, expressive, and alive even without cloud AI.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {}
}
